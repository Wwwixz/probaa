# Скопируйте этот файл в .env и заполните значения.

# Postgres для авторизации.
# В примере ниже база в Docker проброшена на localhost:5433.
DATABASE_URL=postgres://postgres:qwe126asa@localhost:5433/tutu_auth

# Имя cookie сессии. Можно оставить по умолчанию.
AUTH_COOKIE_NAME=tutu_session

# Сколько дней держать сессию.
AUTH_SESSION_TTL_DAYS=7

# MCP от Tutu и ключ для GigaChat.
TUTU_MCP_URL=https://mcp.tutu.ru/mcp
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_AUTH_KEY=

# Ключ 2ГИС MapGL — получить бесплатно на https://docs.2gis.com/ru/mapgl/overview
# Префикс PUBLIC_ обязателен — так Astro/Vite делает переменную доступной в браузере.
PUBLIC_2GIS_API_KEY=
