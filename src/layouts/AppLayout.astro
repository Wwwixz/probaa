---
/**
 * Базовый layout-компонент, в который оборачиваются все остальные страницы.
 * Содержит общую структуру HTML документа (head, body).
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	/** Заголовок страницы, подставляется в тег <title> */
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		{/* 
			Подключаем ClientRouter из astro:transitions
			Это включает механизм SPA-подобной навигации: при клике на ссылки
			страницы не перезагружаются целиком, а подменяется только контент (slot).
		*/}
		<ClientRouter />
	</head>
	<body class="antialiased">
		<div class="app-shell">
			{/* Сюда будет подставляться контент конкретной страницы */}
			<slot />
		</div>
	</body>
</html>
