---
import AppLayout from '../layouts/AppLayout.astro';
import { AiAgentScreen } from '../features/chat/AiAgentScreen';
import { getChatById } from '../entities/chat/mockChats';

const aiAgentChat = getChatById('ai-agent');

if (!aiAgentChat) {
	throw new Error('AI Agent chat not found');
}
---

<AppLayout title="ИИ-агент — TUTU">
	<AiAgentScreen chat={aiAgentChat} client:load />
</AppLayout>
